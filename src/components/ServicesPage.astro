---
import Base from "../layouts/Base.astro";
import type { Accent } from "../data/products";
import { SITE, pageUrl, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

type Proof = { name: string; url: string };
type Service = {
  icon: string;
  accent: Accent;
  title: string;
  body: string;
  includes: string[];
  tags: string[];
  proof?: Proof[];
  service: string;
};

const icons = {
  code: '<polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />',
  phone: '<rect x="5" y="2" width="14" height="20" rx="2" ry="2" /><line x1="12" y1="18" x2="12.01" y2="18" />',
  cloud: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" />',
  db: '<ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />',
  iot: '<rect x="4" y="4" width="16" height="16" rx="2" /><rect x="9" y="9" width="6" height="6" /><path d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 14h3M1 9h3M1 14h3" />',
  link: '<path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" /><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />',
  cms: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" />',
  help: '<circle cx="12" cy="12" r="10" /><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><line x1="12" y1="17" x2="12.01" y2="17" />',
};

const proof = {
  atur: { name: "Atur", url: "https://diatur.com" },
  revklik: { name: "RevKlik", url: "https://revklik.com" },
  andonfast: { name: "AndonFAST", url: "https://andonfast.com" },
  voltrus: { name: "Voltrus", url: "https://voltrus.id" },
  cloudagni: { name: "CloudAgni", url: "https://cloudagni.id" },
  nyaur: { name: "Nyaur", url: "https://nyaur.id" },
  pakustadz: { name: "PakUstadz", url: "https://pakustadz.com" },
  dwitriyono: { name: "dwitriyono.com", url: "https://dwitriyono.com" },
  opexmx: { name: "mx.opexcg.com", url: "https://mx.opexcg.com" },
} satisfies Record<string, Proof>;

const copy = {
  en: {
    title: "Services — Joyo Digitama Solusi",
    description:
      "Custom software, mobile apps, industrial IoT, cloud, databases, system integration, and CMS, built by the Malang team that also runs its own products.",
    h1: "What we build for you",
    lede:
      "Seven kinds of work, one team. The engineers who build and run our own products scope your project in plain language, ship it in working increments, and document it so your team can run it.",
    includesLabel: "Typical work",
    proofLabel: "Our work",
    cardLink: "Start a project like this",
    services: [
      {
        icon: icons.code,
        accent: "green",
        title: "Custom software",
        body: "Web apps, internal tools, and APIs shaped around how your team actually works. One place to do the job, instead of a spreadsheet and copy-paste between systems.",
        includes: ["Internal tools and admin panels", "Customer portals and web apps", "APIs and back-office automation"],
        tags: ["React", "TypeScript", "Python", "Hono"],
        proof: [proof.atur, proof.revklik],
        service: "custom-software",
      },
      {
        icon: icons.phone,
        accent: "blue",
        title: "Mobile apps",
        body: "Android and iOS apps for field teams, customers, and operators on the shop floor. Built for the phones your team already carries, and usable when the signal drops.",
        includes: ["Field data collection and inspections", "Customer-facing apps", "Offline-first sync"],
        tags: ["Kotlin", "React Native", "Flutter"],
        service: "mobile-app",
      },
      {
        icon: icons.iot,
        accent: "amber",
        title: "Industrial IoT",
        body: "Connect PLCs, sensors, and machines to dashboards and alerts your supervisors will read. Know a line has stopped while it is stopped, not at the end of the shift.",
        includes: ["PLC and sensor data acquisition", "Downtime and OEE dashboards", "Alerts to WhatsApp, email, or andon"],
        tags: ["Modbus", "MQTT", "OPC UA", "LoRaWAN"],
        proof: [proof.andonfast, proof.voltrus],
        service: "iot-integration",
      },
      {
        icon: icons.cloud,
        accent: "purple",
        title: "Cloud & DevOps",
        body: "Move off a single server, automate deploys, and keep hosting costs predictable. Releases become routine instead of a weekend event.",
        includes: ["Migration off shared hosting or a single VPS", "CI/CD pipelines and staging environments", "Backups, monitoring, and cost reviews"],
        tags: ["Cloudflare", "AWS", "Azure", "Docker"],
        proof: [proof.cloudagni],
        service: "cloud-solutions",
      },
      {
        icon: icons.db,
        accent: "orange",
        title: "Data & databases",
        body: "Schema design, migrations, and tuning for systems that have outgrown their spreadsheet. Reports stop timing out, and everyone works from the same numbers.",
        includes: ["Spreadsheet-to-database migration", "Query and index tuning", "Backups and reporting views"],
        tags: ["PostgreSQL", "MySQL", "SQL Server", "SQLite"],
        service: "database-solutions",
      },
      {
        icon: icons.link,
        accent: "rose",
        title: "System integration",
        body: "Make the ERP, the payment gateway, and the legacy app talk to each other. Orders, stock, and invoices stop being typed in twice.",
        includes: ["ERP and accounting connectors", "Payment gateway and QRIS integration", "Webhooks and scheduled sync jobs"],
        tags: ["REST", "Webhooks", "ERP", "QRIS"],
        proof: [proof.nyaur],
        service: "system-integration",
      },
      {
        icon: icons.cms,
        accent: "green",
        title: "CMS & websites",
        body: "Sites your team can update without calling a developer. Custom CMS builds with structured content and an editorial workflow, not page-builder lock-in, on fast pages search engines can read.",
        includes: ["Company sites and landing pages", "Structured content and editor roles", "Migration from an old WordPress site"],
        tags: ["Astro", "Headless CMS", "WordPress"],
        proof: [proof.dwitriyono, proof.opexmx, proof.pakustadz],
        service: "cms",
      },
    ] as Service[],
    helpTitle: "Not sure which one fits?",
    helpBody: "Most projects touch more than one of these. Describe the problem in your own words and we'll suggest where to start.",
    helpLink: "Tell us about it",
    includesH2: "What you always get",
    always: [
      { title: "Written scope and price", body: "Milestones, a fixed price or a clear rate, and nothing hidden in the fine print." },
      { title: "Working software early", body: "You see a running version at the first milestone, not a big reveal at the end." },
      { title: "A handover your team can use", body: "Source code access, documentation, and training, so your team can run what we build." },
    ],
    ctaH2: "Have a project in mind?",
    ctaP: "Tell us how the work gets done today. We'll reply with honest questions, a rough approach, and whether we're the right fit.",
    ctaPrimary: "Start a project",
    ctaWa: "Chat on WhatsApp",
    waText: "Hello Joyo Digitama, I'd like to discuss a project.",
  },
  id: {
    title: "Layanan — Joyo Digitama Solusi",
    description:
      "Software kustom, aplikasi mobile, IoT industri, cloud, database, integrasi sistem, dan CMS, dikerjakan tim di Malang yang juga menjalankan produknya sendiri.",
    h1: "Yang kami bangun untuk Anda",
    lede:
      "Tujuh jenis pekerjaan, satu tim. Engineer yang membangun dan menjalankan produk kami sendiri menyusun ruang lingkup proyek Anda dengan bahasa yang jelas, mengirimkannya bertahap dalam bentuk software yang sudah jalan, dan mendokumentasikannya agar tim Anda bisa mengelolanya.",
    includesLabel: "Contoh pekerjaan",
    proofLabel: "Karya kami",
    cardLink: "Mulai proyek seperti ini",
    services: [
      {
        icon: icons.code,
        accent: "green",
        title: "Software kustom",
        body: "Aplikasi web, tools internal, dan API yang mengikuti cara kerja tim Anda yang sebenarnya. Satu tempat untuk menyelesaikan pekerjaan, bukan spreadsheet dan salin-tempel antarsistem.",
        includes: ["Tools internal dan panel admin", "Portal pelanggan dan aplikasi web", "API dan otomasi back-office"],
        tags: ["React", "TypeScript", "Python", "Hono"],
        proof: [proof.atur, proof.revklik],
        service: "custom-software",
      },
      {
        icon: icons.phone,
        accent: "blue",
        title: "Aplikasi mobile",
        body: "Aplikasi Android dan iOS untuk tim lapangan, pelanggan, dan operator di lantai produksi. Dibuat untuk ponsel yang sudah dipakai tim Anda, dan tetap bisa dipakai saat sinyal hilang.",
        includes: ["Pengumpulan data dan inspeksi lapangan", "Aplikasi untuk pelanggan", "Sinkronisasi offline"],
        tags: ["Kotlin", "React Native", "Flutter"],
        service: "mobile-app",
      },
      {
        icon: icons.iot,
        accent: "amber",
        title: "IoT industri",
        body: "Hubungkan PLC, sensor, dan mesin ke dashboard dan notifikasi yang benar-benar dibaca supervisor. Anda tahu lini berhenti saat itu juga, bukan di laporan akhir shift.",
        includes: ["Akuisisi data PLC dan sensor", "Dashboard downtime dan OEE", "Notifikasi ke WhatsApp, email, atau andon"],
        tags: ["Modbus", "MQTT", "OPC UA", "LoRaWAN"],
        proof: [proof.andonfast, proof.voltrus],
        service: "iot-integration",
      },
      {
        icon: icons.cloud,
        accent: "purple",
        title: "Cloud & DevOps",
        body: "Pindah dari satu server, otomatiskan deploy, dan jaga biaya hosting tetap terprediksi. Rilis jadi pekerjaan rutin, bukan acara lembur akhir pekan.",
        includes: ["Migrasi dari shared hosting atau satu VPS", "Pipeline CI/CD dan environment staging", "Backup, monitoring, dan tinjauan biaya"],
        tags: ["Cloudflare", "AWS", "Azure", "Docker"],
        proof: [proof.cloudagni],
        service: "cloud-solutions",
      },
      {
        icon: icons.db,
        accent: "orange",
        title: "Data & database",
        body: "Desain skema, migrasi, dan optimasi untuk sistem yang sudah tidak muat di spreadsheet. Laporan tidak lagi timeout, dan semua orang memakai angka yang sama.",
        includes: ["Migrasi dari spreadsheet ke database", "Optimasi query dan index", "Backup dan view untuk laporan"],
        tags: ["PostgreSQL", "MySQL", "SQL Server", "SQLite"],
        service: "database-solutions",
      },
      {
        icon: icons.link,
        accent: "rose",
        title: "Integrasi sistem",
        body: "Hubungkan ERP, payment gateway, dan aplikasi lama supaya saling bicara. Pesanan, stok, dan invoice tidak perlu diketik dua kali.",
        includes: ["Konektor ERP dan akuntansi", "Integrasi payment gateway dan QRIS", "Webhook dan sinkronisasi terjadwal"],
        tags: ["REST", "Webhook", "ERP", "QRIS"],
        proof: [proof.nyaur],
        service: "system-integration",
      },
      {
        icon: icons.cms,
        accent: "green",
        title: "CMS & website",
        body: "Website yang bisa diperbarui tim Anda tanpa harus memanggil developer. CMS kustom dengan konten terstruktur dan alur editorial, tidak terkunci di page builder, dengan halaman cepat yang mudah dibaca mesin pencari.",
        includes: ["Website perusahaan dan landing page", "Konten terstruktur dan peran editor", "Migrasi dari situs WordPress lama"],
        tags: ["Astro", "Headless CMS", "WordPress"],
        proof: [proof.dwitriyono, proof.opexmx, proof.pakustadz],
        service: "cms",
      },
    ] as Service[],
    helpTitle: "Belum yakin mana yang cocok?",
    helpBody: "Kebanyakan proyek menyentuh lebih dari satu layanan. Ceritakan masalahnya dengan bahasa Anda sendiri, kami sarankan dari mana sebaiknya mulai.",
    helpLink: "Ceritakan kebutuhan Anda",
    includesH2: "Yang selalu Anda dapatkan",
    always: [
      { title: "Ruang lingkup dan harga tertulis", body: "Milestone, harga tetap atau tarif yang jelas, tanpa biaya tersembunyi." },
      { title: "Software yang jalan sejak awal", body: "Anda melihat versi yang berjalan di milestone pertama, bukan kejutan di akhir." },
      { title: "Serah terima yang bisa dipakai", body: "Akses source code, dokumentasi, dan pelatihan, agar tim Anda bisa mengelola apa yang kami bangun." },
    ],
    ctaH2: "Punya proyek yang ingin dibahas?",
    ctaP: "Ceritakan bagaimana pekerjaan berjalan hari ini. Kami akan membalas dengan pertanyaan yang jujur, gambaran pendekatan, dan apakah kami cocok untuk proyek Anda.",
    ctaPrimary: "Mulai proyek",
    ctaWa: "Chat via WhatsApp",
    waText: "Halo Joyo Digitama, saya ingin mendiskusikan proyek.",
  },
}[lang];

const contact = pageUrl("contact", lang);
const arrow =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>';
---

<Base lang={lang} title={copy.title} description={copy.description} path="services">
  <section class="page-hero">
    <div class="container">
      <h1>{copy.h1}</h1>
      <p>{copy.lede}</p>
    </div>
  </section>

  <section class="services-section">
    <div class="container">
      <div class="cards-grid cols-2">
        {copy.services.map((s) => (
          <article class="card service-card reveal">
            <div class={`card-icon ${s.accent}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={s.icon} /></div>
            <h2>{s.title}</h2>
            <p>{s.body}</p>
            <div class="service-label">{copy.includesLabel}</div>
            <ul class="service-includes">
              {s.includes.map((item) => <li>{item}</li>)}
            </ul>
            <div class="tags">
              {s.tags.map((t) => <span class={`tag ${s.accent}`}>{t}</span>)}
            </div>
            {s.proof && (
              <p class="service-proof">
                <span>{copy.proofLabel}:</span>{" "}
                {s.proof.map((p, i) => (
                  <Fragment>{i > 0 && ", "}<a href={p.url} target="_blank" rel="noopener">{p.name}</a></Fragment>
                ))}
              </p>
            )}
            <a href={`${contact}?service=${s.service}`} class="service-link" aria-label={`${copy.cardLink}: ${s.title}`}>
              {copy.cardLink} <Fragment set:html={arrow} />
            </a>
          </article>
        ))}
        <article class="card service-card help-card reveal">
          <div class="card-icon green"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons.help} /></div>
          <h2>{copy.helpTitle}</h2>
          <p>{copy.helpBody}</p>
          <a href={contact} class="btn btn-primary">{copy.helpLink} <Fragment set:html={arrow} /></a>
        </article>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.includesH2}</h2>
      </div>
      <ol class="process-steps always-grid">
        {copy.always.map((a, i) => (
          <li class="step reveal">
            <div class="step-number">{String(i + 1).padStart(2, "0")}</div>
            <h3>{a.title}</h3>
            <p>{a.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="cta-section reveal">
        <h2>{copy.ctaH2}</h2>
        <p>{copy.ctaP}</p>
        <div class="cta-actions">
          <a href={contact} class="btn btn-primary btn-lg">{copy.ctaPrimary} <Fragment set:html={arrow} /></a>
          <a href={`https://wa.me/${SITE.phoneWa}?text=${encodeURIComponent(copy.waText)}`} class="btn btn-outline btn-lg" target="_blank" rel="noopener">{copy.ctaWa}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .services-section { padding-top: 0; }

  .service-card {
    display: flex;
    flex-direction: column;
  }

  .service-card p { max-width: 560px; }

  .service-label {
    margin-top: 24px;
    margin-bottom: 10px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }

  .service-includes {
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .service-includes li {
    position: relative;
    padding-left: 18px;
    color: var(--text-dim);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .service-includes li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 8px;
    height: 1px;
    background: var(--phosphor);
  }

  .service-proof {
    margin-top: 16px;
    font-size: 0.875rem;
  }

  .service-proof span {
    color: var(--text-muted);
  }

  .service-proof a {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--border-hover);
    text-underline-offset: 3px;
  }

  .service-proof a:hover { color: var(--phosphor); text-decoration-color: currentColor; }

  .service-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding-top: 24px;
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--phosphor);
    align-self: flex-start;
  }

  .service-link:hover { gap: 10px; }

  .help-card {
    justify-content: center;
    border-style: dashed;
    border-color: var(--phosphor-30);
  }

  .help-card .btn {
    margin-top: 24px;
    align-self: flex-start;
  }

  .always-grid {
    list-style: none;
    grid-template-columns: repeat(3, 1fr);
  }

  @media (max-width: 960px) {
    .always-grid { grid-template-columns: 1fr; }
  }
</style>
