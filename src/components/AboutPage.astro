      { year: "2026", title: "Waqtu", desc: "Prayer times in the Mac menu bar, with calendar blocks during prayer, for Muslim professionals." },
      { year: "2026", title: "RevKlik and E-Pondok", desc: "RevKlik, revenue-first analytics with user journeys and revenue attribution. E-Pondok, face-based attendance and visitor management for pesantren." },
      { year: "2026", title: "Client sites", desc: "dwitriyono.com, a custom CMS for a dakwah publisher, and mx.opexcg.com, the landing site for the OpexMX maintenance platform." },
      { year: "2026", title: "Atur and AturPDF", desc: "Mission control for AI coding agents, and free PDF tools that run entirely in the browser." },
      { year: "2026", title: "PakUstadz, Paparan AI, Nyaur, CloudAgni", desc: "Websites for study groups, an AI presentation studio, a Merchant of Record for selling software in Indonesia, and Cloudflare hosting paid in Rupiah." },
      { year: "2026", title: "JoyoRogo, JoyoFit", desc: "A calorie tracker that reads Indonesian food from a photo, and an open-source companion app for compatible smartwatches." },
