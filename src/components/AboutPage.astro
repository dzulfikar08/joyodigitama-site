    gap: 16px;
    margin-top: 48px;
  }

  .swatch.green { background: var(--phosphor); }
  .swatch.dark { background: var(--bg); }

  .work-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 20px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--phosphor);
  }

  .work-link:hover { text-decoration: underline; text-underline-offset: 4px; }

  @media (max-width: 680px) {
    .color-grid { grid-template-columns: 1fr; }
  }
</style>
