---
import Base from "../layouts/Base.astro";
import { products } from "../data/products";
import { SITE, pageUrl, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const liveCount = products.filter((p) => p.status === "live").length;

const icons = {
  eye: '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" />',
  steps: '<polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" />',
  server: '<rect x="2" y="3" width="20" height="8" rx="2" /><rect x="2" y="13" width="20" height="8" rx="2" /><line x1="6" y1="7" x2="6.01" y2="7" /><line x1="6" y1="17" x2="6.01" y2="17" />',
  doc: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" />',
  file: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="9" y1="13" x2="15" y2="13" /><line x1="9" y1="17" x2="13" y2="17" />',
  cloud: '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" /><line x1="12" y1="8" x2="12" y2="16" /><line x1="8" y1="12" x2="16" y2="12" />',
};

type Accent = "green" | "blue" | "purple" | "orange";

const copy = {
  en: {
    title: "About Us — Joyo Digitama Solusi",
    description:
      "Joyo Digitama Solusi is a software studio in Malang, Indonesia, founded in 2025. Meet the founder, see the products we run, and the client sites we built.",
    h1: "About Joyo Digitama Solusi",
    heroP:
      "A software studio in Malang, East Java. We build and run our own products for factories, farms, pesantren, and small businesses, and take on custom projects for clients.",
    facts: [
      { value: SITE.founded, label: "founded" },
      { value: "Malang", label: "East Java, Indonesia" },
      { value: String(liveCount), label: "products live today" },
    ],
    mvH2: "Mission & vision",
    missionTitle: "Mission",
    visionTitle: "Vision",
    mission:
      "Build software that people on the line, in the barn, and in the school office actually use, and keep it running long after launch day.",
    vision:
      "Be the Indonesian studio that operations teams trust with their daily work: products that run shifts, herds, and admissions, supported by the people who wrote them.",
    valuesH2: "What we hold ourselves to",
