const arrow =
  '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg>';
---

<Base lang={lang} title={copy.title} description={copy.description} path="about">
  <section class="page-hero">
    <div class="container">
      <h1>{copy.h1}</h1>
      <p>{copy.heroP}</p>
      <div class="stats-row">
        {copy.facts.map((f) => (
          <div class="stat">
            <div class="stat-value">{f.value}</div>
            <div class="stat-label">{f.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.mvH2}</h2>
      </div>
      <div class="mv-grid">
        <div class="mv-card mission reveal">
          <h3>{copy.missionTitle}</h3>
          <p>{copy.mission}</p>
        </div>
        <div class="mv-card vision reveal">
          <h3>{copy.visionTitle}</h3>
          <p>{copy.vision}</p>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.valuesH2}</h2>
      </div>
      <div class="cards-grid cols-2">
        {copy.values.map((v) => (
          <div class="card reveal">
            <div class={`card-icon ${v.accent}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={v.icon} /></div>
            <h3>{v.title}</h3>
            <p>{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.logoH2}</h2>
        <p>{copy.logoP}</p>
      </div>
      <div class="logo-meaning-grid reveal">
        <div class="logo-display">
          <img src="/images/logo-joyodigitama.svg" alt={copy.logoAlt} />
        </div>
        <div class="logo-parts">
          {copy.logoParts.map((part, i) => (
            <div class="logo-card">
              <div class="card-head">
                <div class="card-num">{i + 1}</div>
                <div>
                  <h3>{part.title}</h3>
                  <p set:html={part.body} />
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="color-grid reveal">
        {copy.colors.map((c) => (
          <div class="color-card">
            <div class="color-swatch">
              <div class={`swatch ${c.swatch}`}></div>
              <h3>{c.title}</h3>
            </div>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
      <div class="interpretation-card reveal">
        <h3>{copy.interpTitle}</h3>
        <p>{copy.interp}</p>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.timelineH2}</h2>
        <p>{copy.timelineP}</p>
      </div>
      <div class="timeline reveal">
        {copy.timeline.map((t) => (
          <div class="timeline-item">
            <div class="timeline-year">{t.year}</div>
            <div class="timeline-title">{t.title}</div>
            <div class="timeline-desc">{t.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.workH2}</h2>
        <p>{copy.workP}</p>
      </div>
      <div class="cards-grid cols-2">
        {copy.work.map((w) => (
          <div class="card reveal">
            <div class={`card-icon ${w.accent}`}><svg viewBox="0 0 24 24" aria-hidden="true" set:html={w.icon} /></div>
            <h3>{w.name}</h3>
            <p>{w.body}</p>
            <div class="tags">
              {w.tags.map((t) => <span class={`tag ${w.accent}`}>{t}</span>)}
            </div>
            <a href={w.url} target="_blank" rel="noopener" class={`work-link ${w.accent}`} aria-label={`${copy.viewLive}: ${w.name}`}>
              {copy.viewLive} <Fragment set:html={arrow} />
            </a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <h2>{copy.teamH2}</h2>
      </div>
      <div class="leadership-card reveal">
        <img src="/images/dzulfikar.webp" alt={copy.founderAlt} class="leadership-avatar" width="80" height="80" loading="lazy" />
        <h3>{copy.founderName}</h3>
        <div class="leadership-role">{copy.founderRole}</div>
        <p class="bio">{copy.founderBio}</p>
        <div class="leadership-socials">
          {socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" title={s.label} aria-label={s.label} set:html={s.svg} />
          ))}
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="cta-section reveal">
        <h2>{copy.ctaH2}</h2>
        <p>{copy.ctaP}</p>
        <div class="cta-actions">
          <a href={pageUrl("contact", lang)} class="btn btn-primary btn-lg">{copy.ctaPrimary} <Fragment set:html={arrow} /></a>
          <a href={`https://wa.me/${SITE.phoneWa}?text=${encodeURIComponent(copy.waText)}`} class="btn btn-outline btn-lg" target="_blank" rel="noopener">{copy.ctaWa}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .logo-parts {
    display: flex;
    flex-direction: column;
    gap: 16px;
