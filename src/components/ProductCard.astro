---
import type { Product, Accent } from "../data/products";
import type { Lang } from "../data/site";

interface Props {
  product: Product;
  lang: Lang;
}

const { product, lang } = Astro.props;

const accentHex: Record<Accent, string> = {
  green: "#00ff88",
  blue: "#3ddcff",
  purple: "#b98bff",
  rose: "#ff5c85",
  orange: "#ff8a4c",
  amber: "#ffc233",
};

const live = Boolean(product.url);
const host = product.url ? new URL(product.url).host : null;
const footLabel = host ?? (lang === "id" ? "Segera hadir" : "Coming soon");

const Card = live ? "a" : "div";
const cardAttrs = live ? { href: product.url, target: "_blank", rel: "noopener" } : {};
---
<Card {...cardAttrs} class:list={["product-card reveal", product.accent, { "coming-soon": !live }]}>
  <div class="product-head">
    {product.logo ? (
      <img src={product.logo} alt="" class="product-logo" width="44" height="44" loading="lazy" />
    ) : (
      <div class="product-logo product-logo-mono" style={`background:${accentHex[product.accent]}`} aria-hidden="true">
        {product.name[0]}
      </div>
    )}
  </div>
  <h3>{product.name}</h3>
  <p>{product.desc[lang]}</p>
  <div class="tags">
    {product.tags[lang].map((tag) => (
      <span class={`tag ${product.accent}`}>{tag}</span>
    ))}
  </div>
  <div class="product-arrow">
    <span>{footLabel}</span>
    {live && <span aria-hidden="true">&#8599;</span>}
  </div>
</Card>

<style>
  .product-logo-mono {
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 700;
    color: #03110a;
  }
</style>
