---
import Base from "../layouts/Base.astro";
import { SITE, type Lang } from "../data/site";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const copy = {
  en: {
    title: "Contact — Joyo Digitama Solusi",
    description:
      "Email or WhatsApp Joyo Digitama Solusi in Malang, Indonesia about custom software, mobile apps, industrial IoT, or a CMS. We reply with clear next steps.",
    h1: "Start a project",
    lead: "Tell us what you want to build or fix. A short description is enough. We reply with questions or a suggested next step, usually within two business days.",
    email: "Email",
    whatsapp: "WhatsApp",
    location: "Location",
    locationValue: "Malang, East Java, Indonesia",
    response: "Response time",
    responseValue: "Usually within two business days",
    formH2: "Send a message",
    formNote: "This opens your email app with the message filled in. Nothing is stored on this site.",
    name: "Name",
    namePh: "Your name",
    emailPh: "you@company.com",
    company: "Company",
    optional: "(optional)",
    companyPh: "Company or organisation",
    service: "What do you need?",
    servicePh: "Choose a service",
    services: {
      "custom-software": "Custom software",
      "mobile-app": "Mobile apps",
      "iot-integration": "Industrial IoT",
      "cloud-solutions": "Cloud & DevOps",
      "database-solutions": "Data & databases",
      "system-integration": "System integration",
      cms: "CMS & websites",
      other: "Other",
    },
    message: "Message",
    messagePh: "What are you trying to do, who will use it, and when do you need it?",
    send: "Send message",
    chat: "Chat on WhatsApp",
    waText: "Hello Joyo Digitama Solusi, I would like to discuss a project.",
    mail: { subject: "Project inquiry", general: "General", name: "Name", company: "Company", service: "Service" },
  },
  id: {
    title: "Kontak — Joyo Digitama Solusi",
    description:
      "Hubungi Joyo Digitama Solusi di Malang via email atau WhatsApp untuk software kustom, aplikasi mobile, IoT industri, atau CMS. Kami balas dengan langkah jelas.",
    h1: "Mulai proyek",
    lead: "Ceritakan apa yang ingin Anda bangun atau perbaiki. Deskripsi singkat sudah cukup. Kami akan membalas dengan pertanyaan atau usulan langkah berikutnya, biasanya dalam dua hari kerja.",
    email: "Email",
    whatsapp: "WhatsApp",
    location: "Lokasi",
    locationValue: "Malang, Jawa Timur, Indonesia",
    response: "Waktu respons",
    responseValue: "Biasanya dalam dua hari kerja",
    formH2: "Kirim pesan",
    formNote: "Tombol kirim membuka aplikasi email Anda dengan pesan yang sudah terisi. Tidak ada data yang disimpan di situs ini.",
    name: "Nama",
    namePh: "Nama Anda",
    emailPh: "anda@perusahaan.com",
    company: "Perusahaan",
    optional: "(opsional)",
    companyPh: "Nama perusahaan atau lembaga",
    service: "Apa yang Anda butuhkan?",
    servicePh: "Pilih layanan",
    services: {
      "custom-software": "Software kustom",
      "mobile-app": "Aplikasi mobile",
      "iot-integration": "IoT industri",
      "cloud-solutions": "Cloud & DevOps",
      "database-solutions": "Data & database",
      "system-integration": "Integrasi sistem",
      cms: "CMS & website",
      other: "Lainnya",
    },
    message: "Pesan",
    messagePh: "Apa yang ingin Anda capai, siapa penggunanya, dan kapan dibutuhkan?",
    send: "Kirim pesan",
    chat: "Chat via WhatsApp",
    waText: "Halo Joyo Digitama Solusi, saya ingin mendiskusikan sebuah proyek.",
    mail: { subject: "Permintaan proyek", general: "Umum", name: "Nama", company: "Perusahaan", service: "Layanan" },
  },
}[lang];

const waLink = `https://wa.me/${SITE.phoneWa}`;
const waChat = `${waLink}?text=${encodeURIComponent(copy.waText)}`;
const path = "contact";
---

<Base lang={lang} title={copy.title} description={copy.description} path={path}>
  <section class="page-hero">
    <div class="container">
      <h1>{copy.h1}</h1>
      <p>{copy.lead}</p>
    </div>
  </section>

  <section class="contact-section">
    <div class="container">
      <div class="contact-grid">
        <div class="info-stack">
          <div class="card info-card reveal">
            <div class="card-icon green">
              <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
            </div>
            <h2>{copy.email}</h2>
            <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon green">
              <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            </div>
            <h2>{copy.whatsapp}</h2>
            <p><a href={waLink} target="_blank" rel="noopener">{SITE.phoneDisplay}</a></p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon blue">
              <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            </div>
            <h2>{copy.location}</h2>
            <p>{copy.locationValue}</p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon amber">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            </div>
            <h2>{copy.response}</h2>
            <p>{copy.responseValue}</p>
          </div>
        </div>

        <div class="card form-card reveal">
          <h2>{copy.formH2}</h2>
          <p class="form-note">{copy.formNote}</p>
          <form
            id="contact-form"
            data-email={SITE.email}
            data-subject={copy.mail.subject}
            data-general={copy.mail.general}
            data-l-name={copy.mail.name}
            data-l-company={copy.mail.company}
            data-l-service={copy.mail.service}
          >
            <div class="form-row">
              <div class="form-field">
                <label for="cf-name">{copy.name}</label>
                <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder={copy.namePh} />
              </div>
              <div class="form-field">
                <label for="cf-email">{copy.email}</label>
                <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder={copy.emailPh} />
              </div>
            </div>
            <div class="form-field">
              <label for="cf-company">{copy.company} <span class="optional">{copy.optional}</span></label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder={copy.companyPh} />
            </div>
            <div class="form-field">
              <label for="cf-service">{copy.service}</label>
              <select id="cf-service" name="service">
                <option value="" disabled selected>{copy.servicePh}</option>
                {Object.entries(copy.services).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
            </div>
            <div class="form-field">
              <label for="cf-message">{copy.message}</label>
              <textarea id="cf-message" name="message" required rows="5" placeholder={copy.messagePh}></textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                {copy.send}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
                >
              </button>
              <a href={waChat} target="_blank" rel="noopener" class="btn btn-outline">{copy.chat}</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;
  const serviceSelect = document.getElementById("cf-service") as HTMLSelectElement | null;

  const preselect = new URLSearchParams(location.search).get("service");
  if (preselect && serviceSelect && Array.from(serviceSelect.options).some((o) => o.value === preselect)) {
    serviceSelect.value = preselect;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const d = form.dataset;
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const company = String(data.get("company") || "").trim();
    const service =
      serviceSelect && serviceSelect.selectedIndex > 0
        ? serviceSelect.options[serviceSelect.selectedIndex].text.trim()
        : "";
    const message = String(data.get("message") || "").trim();

    const subject = `${d.subject}: ${service || d.general} — ${name}`;
    const body = [
      `${d.lName}: ${name}`,
      `Email: ${email}`,
      `${d.lCompany}: ${company || "-"}`,
      `${d.lService}: ${service || "-"}`,
      "",
      message,
    ].join("\n");

    window.location.href = `mailto:${d.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-section {
    padding-top: 0;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: start;
  }

  .info-stack {
    display: grid;
    gap: 16px;
  }

  .info-card p a {
    color: var(--phosphor);
    text-decoration: none;
    word-break: break-all;
  }

  .info-card p a:hover {
    text-decoration: underline;
  }

  .form-card {
    padding: 40px 36px;
  }

  .form-card h2 {
    margin-bottom: 8px;
  }

  .form-note {
    color: var(--text-muted);
    font-size: 0.875rem;
    margin-bottom: 28px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-field {
    margin-bottom: 20px;
  }

  .form-field label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 8px;
  }

  .form-field .optional {
    font-weight: 400;
    color: var(--text-muted);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border-hover);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }

  .form-field select option {
    background: var(--bg-raised);
    color: var(--text);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--phosphor-50);
    box-shadow: 0 0 0 3px var(--phosphor-15);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-muted);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }

    .form-card {
      padding: 28px 22px;
    }
  }
</style>
