---
import Base from "../layouts/Base.astro";
---

<Base
  title="Industry Solutions — Joyo Digitama Solusi"
  description="Digital solutions for manufacturing, logistics, smart buildings, and energy sectors. Proven results with measurable outcomes."
  path="solutions"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="section-tag" style="margin-bottom:24px;display:block;">// industries</span>
      <h1>Industry <span class="phosphor">Solutions</span></h1>
      <p>Tailored digital solutions with proven results across multiple industries</p>
    </div>
  </section>

  <!-- Solution Cards -->
  <section>
    <div class="container">
      <div class="cards-grid">
        <div class="card reveal">
          <div class="card-icon green"><svg viewBox="0 0 24 24"><path d="M2 20a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V8l-7 5V8l-7 5V4a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2z" /></svg></div>
          <h3>Manufacturing</h3>
          <p>Production monitoring, quality management systems, and predictive maintenance solutions for smart factories.</p>
          <div class="case-study green">
            <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
            23% OEE Improvement
          </div>
          <div class="tags">
            <span class="tag green">MES</span>
            <span class="tag green">Andon System</span>
            <span class="tag green">Predictive Maintenance</span>
            <span class="tag green">Quality Control</span>
          </div>
        </div>

        <div class="card reveal">
          <div class="card-icon blue"><svg viewBox="0 0 24 24"><rect x="1" y="3" width="15" height="13" /><polygon points="16 8 20 8 23 11 23 16 16 16 16 8" /><circle cx="5.5" cy="18.5" r="2.5" /><circle cx="18.5" cy="18.5" r="2.5" /></svg></div>
          <h3>Logistics &amp; Supply Chain</h3>
          <p>Fleet tracking, warehouse management, and supply chain visibility solutions for logistics operations.</p>
          <div class="case-study blue">
            <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
            35% Delivery Time Reduction
          </div>
          <div class="tags">
            <span class="tag blue">Fleet Management</span>
            <span class="tag blue">WMS</span>
            <span class="tag blue">Route Optimization</span>
            <span class="tag blue">Real-time Tracking</span>
          </div>
        </div>

        <div class="card reveal">
          <div class="card-icon purple"><svg viewBox="0 0 24 24"><rect x="4" y="2" width="16" height="20" rx="2" ry="2" /><path d="M9 22v-4h6v4" /><path d="M8 6h.01" /><path d="M16 6h.01" /><path d="M12 6h.01" /><path d="M12 10h.01" /><path d="M12 14h.01" /><path d="M16 10h.01" /><path d="M16 14h.01" /><path d="M8 10h.01" /><path d="M8 14h.01" /></svg></div>
          <h3>Smart Buildings</h3>
          <p>HVAC optimization, energy management, and integrated security systems for intelligent buildings.</p>
          <div class="case-study purple">
            <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
            28% Energy Cost Reduction
          </div>
          <div class="tags">
            <span class="tag purple">BMS</span>
            <span class="tag purple">HVAC Control</span>
            <span class="tag purple">Energy Monitoring</span>
            <span class="tag purple">Access Control</span>
          </div>
        </div>

        <div class="card reveal">
          <div class="card-icon orange"><svg viewBox="0 0 24 24"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2" /></svg></div>
          <h3>Energy &amp; Utilities</h3>
          <p>Smart grid monitoring, renewable energy management, and utility infrastructure optimization.</p>
          <div class="case-study orange">
            <svg viewBox="0 0 24 24"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
            18% Grid Efficiency Improvement
          </div>
          <div class="tags">
            <span class="tag orange">Smart Grid</span>
            <span class="tag orange">SCADA</span>
            <span class="tag orange">Renewable Monitoring</span>
            <span class="tag orange">Load Balancing</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Implementation Process -->
  <section>
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">// process</span>
        <h2>Implementation Process</h2>
        <p>A structured approach from assessment to ongoing support</p>
      </div>
      <div class="process-steps reveal">
        <div class="step">
          <div class="step-number">1</div>
          <h4>Assessment</h4>
          <p>We analyze your current systems and identify digitalization opportunities.</p>
        </div>
        <div class="step">
          <div class="step-number">2</div>
          <h4>Design</h4>
          <p>Our team designs a tailored solution architecture for your specific needs.</p>
        </div>
        <div class="step">
          <div class="step-number">3</div>
          <h4>Deploy</h4>
          <p>We implement and deploy the solution with minimal disruption to operations.</p>
        </div>
        <div class="step">
          <div class="step-number">4</div>
          <h4>Support</h4>
          <p>Ongoing monitoring, maintenance, and optimization for continuous improvement.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container">
      <div class="cta-section bracket-box reveal">
        <h2>Ready to Transform Your Industry?</h2>
        <p>Let's discuss how we can digitalize your operations.</p>
        <a href="/contact/" class="btn btn-primary btn-lg">
          Discuss Your Solution
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
          >
        </a>
      </div>
    </div>
  </section>
</Base>
