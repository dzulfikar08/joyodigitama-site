          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section>
    <div class="container">
      <div class="cta-section bracket-box reveal">
        <h2>Ready to Digitalize Your Operations?</h2>
        <p>Get in touch with us to discuss how we can help transform your business with custom software solutions.</p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">
            Contact Us
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
          <a href="https://wa.me/6289680839591" class="btn btn-outline btn-lg" target="_blank" rel="noopener">
            WhatsApp Us
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
