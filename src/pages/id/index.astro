---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import { products } from "../../data/products";
---

<Base
  lang="id"
  title="Joyo Digitama Solusi — Solusi Digitalisasi Industri & IoT"
  description="Joyo Digitama Solusi menghadirkan pengembangan perangkat lunak kustom, solusi IoT industri, dan produk SaaS untuk manufaktur, logistik, dan gedung pintar. Berbasis di Malang, Indonesia."
  path=""
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>
          Solusi Perangkat Lunak<br />untuk
          <span class="rotating-text">
            <span>Industri</span>
            <span>Bisnis</span>
            <span>Pertanian</span>
          </span>
        </h1>
        <p class="subtitle">
          Kami menghadirkan pengembangan perangkat lunak kustom, solusi IoT industri, dan produk SaaS yang
          dirancang untuk mendigitalisasi dan mengoptimalkan operasional Anda.
        </p>
        <div class="hero-actions">
          <a href="/id/products/" class="btn btn-primary btn-lg">
            Jelajahi Produk
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
          >
          </a>
          <a href="/id/contact/" class="btn btn-outline btn-lg">Pengembangan Kustom</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <div class="stat-value">5+</div>
            <div class="stat-label">Tahun Pengalaman</div>
          </div>
          <div class="stat">
            <div class="stat-value">10+</div>
            <div class="stat-label">Industri Dilayani</div>
          </div>
          <div class="stat">
            <div class="stat-value">20+</div>
            <div class="stat-label">Proyek Diselesaikan</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">// apa yang kami kerjakan</span>
        <h2>Layanan Kami</h2>
        <p>Layanan pengembangan perangkat lunak dan transformasi digital menyeluruh untuk industri modern</p>
      </div>
      <div class="cards-grid">
        <div class="card reveal">
          <div class="card-icon green"><svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg></div>
          <h3>Pengembangan Perangkat Lunak Kustom</h3>
          <p>Aplikasi web, perangkat lunak desktop, dan pengembangan API yang disesuaikan dengan kebutuhan bisnis Anda.</p>
          <div class="tags">
            <span class="tag green">React</span><span class="tag green">Python</span><span class="tag green">Next.js</span
            ><span class="tag green">Hono</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon blue"><svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" ry="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg></div>
          <h3>Pengembangan Aplikasi Mobile</h3>
          <p>Solusi mobile native dan lintas platform untuk iOS dan Android.</p>
          <div class="tags">
            <span class="tag blue">Kotlin</span><span class="tag blue">React Native</span><span class="tag blue">Flutter</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon purple"><svg viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" /></svg></div>
          <h3>Solusi Cloud</h3>
          <p>Migrasi cloud, otomatisasi DevOps, dan desain arsitektur microservices.</p>
          <div class="tags">
            <span class="tag purple">AWS</span><span class="tag purple">Azure</span><span class="tag purple">Cloudflare</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon orange"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg></div>
          <h3>Solusi Database</h3>
          <p>Desain database, optimasi performa, migrasi, dan strategi backup.</p>
          <div class="tags">
            <span class="tag orange">PostgreSQL</span><span class="tag orange">MySQL</span><span class="tag orange">SQLite</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon amber"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" /></svg></div>
          <h3>Integrasi IoT</h3>
          <p>Integrasi sensor, monitoring real-time, dan solusi otomasi industri.</p>
          <div class="tags">
            <span class="tag amber">MQTT</span><span class="tag amber">LoRaWAN</span><span class="tag amber">Modbus</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon rose"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg></div>
          <h3>Integrasi Sistem</h3>
          <p>Integrasi ERP, pengembangan API, dan modernisasi sistem legacy.</p>
          <div class="tags">
            <span class="tag rose">REST APIs</span><span class="tag rose">GraphQL</span><span class="tag rose">Middleware</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">// apa yang kami bangun</span>
        <h2>Produk Kami</h2>
        <p>Solusi SaaS yang dibangun khusus untuk tantangan industri tertentu</p>
      </div>
      <div class="products-grid">
        {products.map((product) => <ProductCard product={product} lang="id" />)}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="cta-section bracket-box reveal">
        <h2>Butuh Solusi Kustom?</h2>
        <p>
          Kami berspesialisasi membangun perangkat lunak yang dirancang untuk kebutuhan industri tertentu.
          Mari diskusikan solusi terbaik untuk bisnis Anda.
        </p>
        <a href="/id/contact/" class="btn btn-primary btn-lg">
          Diskusikan Proyek Anda
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
          >
        </a>
      </div>
    </div>
  </section>
</Base>
