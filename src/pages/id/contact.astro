---
import Base from "../../layouts/Base.astro";
---

<Base
  lang="id"
  title="Hubungi Kami — Joyo Digitama Solusi"
  description="Hubungi Joyo Digitama Solusi. Kirim email atau WhatsApp untuk mendiskusikan proyek perangkat lunak kustom, IoT, atau digitalisasi Anda. Berbasis di Malang, Jawa Timur, Indonesia."
  path="contact"
>
  <!-- Page Hero -->
  <section class="page-hero">
    <div class="container">
      <span class="section-tag" style="margin-bottom:24px;display:block;">// hubungi kami</span>
      <h1>Hubungi <span class="phosphor">Kami</span></h1>
      <p>Punya proyek dalam pikiran? Ceritakan kebutuhan Anda dan kami akan merespons dalam 1-2 hari kerja</p>
    </div>
  </section>

  <!-- Contact Grid -->
  <section style="padding-top:0;">
    <div class="container">
      <div class="contact-grid">
        <!-- Left: Info Cards -->
        <div class="info-stack">
          <div class="card info-card reveal">
            <div class="card-icon green">
              <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
            </div>
            <h3>Email</h3>
            <p><a href="mailto:dzulfikar.at@joyodigitama.com">dzulfikar.at@joyodigitama.com</a></p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon green">
              <svg viewBox="0 0 24 24"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z" /></svg>
            </div>
            <h3>WhatsApp</h3>
            <p><a href="https://wa.me/6289680839591" target="_blank" rel="noopener">+62 896-8083-9591</a></p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon blue">
              <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
            </div>
            <h3>Lokasi</h3>
            <p>Malang, Jawa Timur, Indonesia</p>
          </div>
          <div class="card info-card reveal">
            <div class="card-icon amber">
              <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            </div>
            <h3>Waktu Respons</h3>
            <p>Kami biasanya membalas dalam 1-2 hari kerja</p>
          </div>
        </div>

        <!-- Right: Contact Form -->
        <div class="card form-card reveal">
          <h3>Kirim pesan kepada kami</h3>
          <form id="contact-form">
            <div class="form-row">
              <div class="form-field">
                <label for="cf-name">Nama</label>
                <input id="cf-name" name="name" type="text" required autocomplete="name" placeholder="Nama Anda" />
              </div>
              <div class="form-field">
                <label for="cf-email">Email</label>
                <input id="cf-email" name="email" type="email" required autocomplete="email" placeholder="anda@perusahaan.com" />
              </div>
            </div>
            <div class="form-field">
              <label for="cf-company">Perusahaan <span class="optional">(opsional)</span></label>
              <input id="cf-company" name="company" type="text" autocomplete="organization" placeholder="Nama perusahaan" />
            </div>
            <div class="form-field">
              <label for="cf-service">Minat Layanan</label>
              <select id="cf-service" name="service">
                <option value="" disabled selected>Pilih layanan</option>
                <option>Perangkat Lunak Kustom</option>
                <option>Aplikasi Mobile</option>
                <option>Solusi Cloud</option>
                <option>Solusi Database</option>
                <option>Integrasi IoT</option>
                <option>Integrasi Sistem</option>
                <option>CMS</option>
                <option>Lainnya</option>
              </select>
            </div>
            <div class="form-field">
              <label for="cf-message">Pesan</label>
              <textarea id="cf-message" name="message" required rows="5" placeholder="Ceritakan tentang proyek, timeline, dan anggaran Anda"></textarea>
            </div>
            <div class="form-actions">
              <button type="submit" class="btn btn-primary">
                Kirim Pesan
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
                  ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
                >
              </button>
              <a
                href="https://wa.me/6289680839591?text=Halo%20Joyo%20Digitama%20Solusi%2C%20saya%20ingin%20mendiskusikan%20sebuah%20proyek."
                target="_blank"
                rel="noopener"
                class="btn btn-outline">Chat via WhatsApp</a
              >
            </div>
          </form>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement | null;

  form?.addEventListener("submit", (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const name = String(data.get("name") || "").trim();
    const email = String(data.get("email") || "").trim();
    const company = String(data.get("company") || "").trim();
    const service = String(data.get("service") || "").trim();
    const message = String(data.get("message") || "").trim();

    const subject = `Permintaan Proyek: ${service || "Umum"} — ${name}`;
    const body = [
      `Nama: ${name}`,
      `Email: ${email}`,
      `Perusahaan: ${company || "-"}`,
      `Layanan: ${service || "-"}`,
      "",
      message,
    ].join("\n");

    window.location.href = `mailto:dzulfikar.at@joyodigitama.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 32px;
    align-items: start;
  }

  .info-stack {
    display: grid;
    gap: 16px;
  }

  .info-card p a {
    color: var(--phosphor);
    text-decoration: none;
    word-break: break-all;
  }

  .info-card p a:hover {
    text-decoration: underline;
  }

  .form-card {
    padding: 40px 36px;
  }

  .form-card h3 {
    margin-bottom: 28px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-field {
    margin-bottom: 20px;
  }

  .form-field label {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin-bottom: 8px;
  }

  .form-field .optional {
    text-transform: none;
    letter-spacing: 0.05em;
    color: var(--text-dim);
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 12px 14px;
    color: var(--text);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    transition: border-color 0.2s;
  }

  .form-field select option {
    background: var(--bg-raised);
    color: var(--text);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    outline: none;
    border-color: var(--phosphor-50);
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder {
    color: var(--text-muted);
  }

  .form-field textarea {
    resize: vertical;
    min-height: 140px;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>
