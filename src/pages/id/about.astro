  <!-- CTA -->
  <section>
    <div class="container">
      <div class="cta-section bracket-box reveal">
        <h2>Siap Mendigitalisasi Operasional Anda?</h2>
        <p>Hubungi kami untuk membahas bagaimana kami dapat membantu mentransformasi bisnis Anda dengan solusi perangkat lunak kustom.</p>
        <div class="cta-actions">
          <a href="/contact/" class="btn btn-primary btn-lg">
            Hubungi Kami
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
