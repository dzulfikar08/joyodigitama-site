---
import Base from "../layouts/Base.astro";
import ProductCard from "../components/ProductCard.astro";
import { products } from "../data/products";
import { SITE } from "../data/site";
---

<Base
  title="Joyo Digitama Solusi — Industrial Digitalization & IoT Solutions"
  description="Joyo Digitama Solusi delivers custom software development, industrial IoT solutions, and SaaS products for manufacturing, logistics, and smart buildings. Based in Malang, Indonesia."
>
  <section class="hero">
    <div class="container">
      <div class="hero-content">
        <h1>
          Software Solutions<br />for
          <span class="rotating-text">
            <span>Industry</span>
            <span>Business</span>
            <span>Farm</span>
          </span>
        </h1>
        <p class="subtitle">
          We deliver custom software development, industrial IoT solutions, and SaaS products designed to
          digitalize and optimize your operations.
        </p>
        <div class="hero-actions">
          <a href="/products/" class="btn btn-primary btn-lg">
            Explore Products
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
              ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
          >
          </a>
          <a href="/contact/" class="btn btn-outline btn-lg">Custom Dev</a>
        </div>
        <div class="hero-stats">
          <div class="stat">
            <div class="stat-value">5+</div>
            <div class="stat-label">Years Experience</div>
          </div>
          <div class="stat">
            <div class="stat-value">10+</div>
            <div class="stat-label">Industries Served</div>
          </div>
          <div class="stat">
            <div class="stat-value">20+</div>
            <div class="stat-label">Projects Delivered</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">// what we do</span>
        <h2>Our Services</h2>
        <p>End-to-end software development and digital transformation services for modern industries</p>
      </div>
      <div class="cards-grid">
        <div class="card reveal">
          <div class="card-icon green"><svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg></div>
          <h3>Custom Software Development</h3>
          <p>Web applications, desktop software, and API development tailored to your business needs.</p>
          <div class="tags">
            <span class="tag green">React</span><span class="tag green">Python</span><span class="tag green">Next.js</span
            ><span class="tag green">Hono</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon blue"><svg viewBox="0 0 24 24"><rect x="5" y="2" width="14" height="20" rx="2" ry="2" /><line x1="12" y1="18" x2="12.01" y2="18" /></svg></div>
          <h3>Mobile App Development</h3>
          <p>Native and cross-platform mobile solutions for iOS and Android platforms.</p>
          <div class="tags">
            <span class="tag blue">Kotlin</span><span class="tag blue">React Native</span><span class="tag blue">Flutter</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon purple"><svg viewBox="0 0 24 24"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z" /></svg></div>
          <h3>Cloud Solutions</h3>
          <p>Cloud migration, DevOps automation, and microservices architecture design.</p>
          <div class="tags">
            <span class="tag purple">AWS</span><span class="tag purple">Azure</span><span class="tag purple">Cloudflare</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon orange"><svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3" /><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" /><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" /></svg></div>
          <h3>Database Solutions</h3>
          <p>Database design, performance optimization, migration, and backup strategies.</p>
          <div class="tags">
            <span class="tag orange">PostgreSQL</span><span class="tag orange">MySQL</span><span class="tag orange">SQLite</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon amber"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" /><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" /></svg></div>
          <h3>IoT Integration</h3>
          <p>Sensor integration, real-time monitoring, and industrial automation solutions.</p>
          <div class="tags">
            <span class="tag amber">MQTT</span><span class="tag amber">LoRaWAN</span><span class="tag amber">Modbus</span>
          </div>
        </div>
        <div class="card reveal">
          <div class="card-icon rose"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><line x1="2" y1="12" x2="22" y2="12" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg></div>
          <h3>System Integration</h3>
          <p>ERP integration, API development, and legacy system modernization.</p>
          <div class="tags">
            <span class="tag rose">REST APIs</span><span class="tag rose">GraphQL</span><span class="tag rose">Middleware</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="section-header reveal">
        <span class="section-tag">// what we build</span>
        <h2>Our Products</h2>
        <p>Purpose-built SaaS solutions designed for specific industry challenges</p>
      </div>
      <div class="products-grid">
        {products.map((product) => <ProductCard product={product} lang="en" />)}
      </div>
    </div>
  </section>

  <section>
    <div class="container">
      <div class="cta-section bracket-box reveal">
        <h2>Need a Custom Solution?</h2>
        <p>
          We specialize in building tailored software for specific industry requirements. Let's discuss how we
          can create the perfect solution for your business.
        </p>
        <a href="/contact/" class="btn btn-primary btn-lg">
          Discuss Your Project
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"
            ><line x1="5" y1="12" x2="19" y2="12" /><polyline points="12 5 19 12 12 19" /></svg
          >
        </a>
      </div>
    </div>
  </section>
</Base>
