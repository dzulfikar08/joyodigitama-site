---
import "../styles/global.css";
import { SITE, ui, footerServices, pageUrl, type Lang } from "../data/site";
import { products } from "../data/products";

import "@fontsource-variable/archivo/wdth.css";

interface Props {
  /** Full page title, e.g. "Services — Joyo Digitama Solusi". */
  title: string;
  description: string;
  /** Page path without lang prefix or slashes: "" (home), "services", "blog/some-post". */
  path?: string;
  lang?: Lang;
  noindex?: boolean;
}

const { title, description, path = "", lang = "en", noindex = false } = Astro.props;
const t = ui[lang];

const enUrl = SITE.domain + pageUrl(path, "en");
const idUrl = SITE.domain + pageUrl(path, "id");
const canonical = lang === "en" ? enUrl : idUrl;
const otherLang: Lang = lang === "en" ? "id" : "en";
const switchHref = pageUrl(path, lang) + `?lang=${otherLang}`;

const navItems = [
  { key: "home", href: pageUrl("", lang), match: "" },
  { key: "services", href: pageUrl("services", lang), match: "services" },
  { key: "products", href: pageUrl("products", lang), match: "products" },
  { key: "solutions", href: pageUrl("solutions", lang), match: "solutions" },
  { key: "blog", href: pageUrl("blog", lang), match: "blog" },
  { key: "about", href: pageUrl("about", lang), match: "about" },
  { key: "contact", href: pageUrl("contact", lang), match: "contact" },
] as const;
const activeSeg = path.split("/")[0];

const orgLd = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://joyodigitama.com/#organization",
  name: SITE.name,
  url: SITE.domain,
  logo: `${SITE.domain}/images/logo-joyodigitama-512.png`,
  image: `${SITE.domain}/images/og-joyodigitama.png`,
  description:
    "Software studio in Malang, Indonesia. We build and run our own products for manufacturing, farming, Islamic education, and small business, and take on custom software, mobile, cloud, and industrial IoT projects.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "Malang",
    addressLocality: "Malang",
    addressRegion: "East Java",
    postalCode: "65100",
    addressCountry: "ID",
  },
  geo: { "@type": "GeoCoordinates", latitude: "-7.9666", longitude: "112.6326" },
  email: SITE.email,
  telephone: `+${SITE.phoneWa}`,
  foundingDate: SITE.founded,
};

---

<!doctype html>
<html lang={lang === "en" ? "en" : "id"}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="geo.region" content="ID-JI" />
    <meta name="geo.placename" content="Malang" />
    <meta name="geo.position" content="-7.9666;112.6326" />
    <meta name="ICBM" content="-7.9666, 112.6326" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="id" href={idUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE.domain}/images/og-joyodigitama.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.name} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "id_ID"} />
    <meta property="og:locale:alternate" content={lang === "en" ? "id_ID" : "en_US"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE.domain}/images/og-joyodigitama.png`} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/svg+xml" href="/images/logo-joyodigitama.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#050c09" />
    <script type="application/ld+json" set:html={JSON.stringify(orgLd)} />
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href={pageUrl("", lang)} class="nav-logo">
          <img src="/images/logo-joyodigitama.svg" alt="" width="30" height="30" />
          <span>Joyo Digitama</span>
        </a>
        <ul class="nav-links">
          {navItems.filter((item) => item.key !== "home").map((item) => (
            <li>
              <a href={item.href} class={activeSeg === item.match ? "active" : undefined}>
                {t.nav[item.key]}
              </a>
            </li>
          ))}
        </ul>
        <div class="nav-actions">
          <a href={switchHref} class="btn btn-outline lang-toggle" aria-label={t.langToggleAria}>{t.langToggle}</a>
          <a href={pageUrl("contact", lang)} class="btn btn-primary">
            {t.getStarted}
          </a>
        </div>
        <button
          class="mobile-toggle"
          onclick="this.setAttribute('aria-expanded', document.querySelector('.mobile-menu').classList.toggle('active'))"
          aria-label="Menu"
          aria-expanded="false"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
            ><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg
          >
        </button>
      </div>
    </nav>
    <div class="mobile-menu">
      {navItems.map((item) => (
        <a href={item.href} class={activeSeg === item.match ? "active" : undefined}>{t.nav[item.key]}</a>
      ))}
      <a href={switchHref} class="btn btn-outline lang-toggle">{t.langToggle}</a>
      <a href={pageUrl("contact", lang)} class="btn btn-primary">{t.getStarted}</a>
    </div>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        <div class="footer-grid">
          <div class="footer-brand">
            <a href={pageUrl("", lang)} class="footer-logo">
              <img src="/images/logo-joyodigitama.svg" alt="" width="28" height="28" />
              <span>{SITE.name}</span>
            </a>
            <p>{t.footer.tagline}</p>
            <div class="footer-contact">
              <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
              <a href={`https://wa.me/${SITE.phoneWa}`} target="_blank" rel="noopener">WhatsApp {SITE.phoneDisplay}</a>
              <a href={SITE.discord} target="_blank" rel="noopener" aria-label={t.footer.discordAria}>{t.footer.discord}</a>
            </div>
          </div>
          <div class="footer-col">
            <h4>{t.footer.services}</h4>
            <ul>
              {footerServices[lang].map((s) => (
                <li><a href={s.href}>{s.label}</a></li>
              ))}
            </ul>
          </div>
          <div class="footer-col">
            <h4>{t.footer.products}</h4>
            <ul class="footer-products">
              {products
                .filter((p) => p.url)
                .map((p) => (
                  <li>
                    <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
                  </li>
                ))}
            </ul>
          </div>
          <div class="footer-col">
            <h4>{t.footer.legal}</h4>
            <ul>
              <li><a href={pageUrl("privacy", lang)}>{t.footer.privacy}</a></li>
              <li><a href={pageUrl("terms", lang)}>{t.footer.terms}</a></li>
              <li><a href={pageUrl("cookies", lang)}>{t.footer.cookies}</a></li>
              <li><a href={pageUrl("contact", lang)}>{t.footer.contact}</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2025–{new Date().getFullYear()} {SITE.name}. {t.footer.rights}</p>
          <p>Malang, Jawa Timur, Indonesia</p>
        </div>
      </div>
    </footer>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("visible");
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" }
      );
      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
      document.querySelectorAll(".mobile-menu a").forEach((a) => {
        a.addEventListener("click", () => document.querySelector(".mobile-menu")?.classList.remove("active"));
      });
    </script>
  </body>
</html>
